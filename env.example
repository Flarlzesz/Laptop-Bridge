# Copy this to ~/.robohack-bridge.env (OUTSIDE the website folder) and fill it in:
#   cp bridge/env.example ~/.robohack-bridge.env && chmod 600 ~/.robohack-bridge.env
# Never put the real file in this folder: the web server would serve it.

SUPABASE_URL=https://wlgencggupxqtqmflydr.supabase.co
# Supabase -> Project Settings -> API Keys -> Secret key (sb_secret_...). It can write and delete everything.
SUPABASE_SECRET_KEY=
# Arduino USB port, find it with:  ls /dev/cu.*
SERIAL_PORT=/dev/cu.usbmodem1101
