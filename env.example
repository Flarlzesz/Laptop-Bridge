# Copy this to .robohack-bridge.env in your home folder and fill it in (see LAPTOP_SETUP.md):
#   macOS:    cp env.example ~/.robohack-bridge.env && chmod 600 ~/.robohack-bridge.env
#   Windows:  copy env.example %USERPROFILE%\.robohack-bridge.env
# Never put the real file in a git or website folder.

SUPABASE_URL=https://wlgencggupxqtqmflydr.supabase.co
# Supabase -> Project Settings -> API Keys -> Secret key (sb_secret_...). It can write and delete everything.
SUPABASE_SECRET_KEY=
# Arduino USB port. macOS: ls /dev/cu.*  (e.g. /dev/cu.usbmodem1101)
#                  Windows: Device Manager -> Ports (COM & LPT)  (e.g. COM3)
SERIAL_PORT=/dev/cu.usbmodem1101
